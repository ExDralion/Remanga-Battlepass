{
  "manifest_version": 3,
  "name": "SailorM Battlepass",
  "description": "Автоматизация задач и мини-игр battlepass на ReManga.",
  "version": "1.0.0",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "*://remanga.org/*",
    "*://*.remanga.org/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://remanga.org/*",
        "*://*.remanga.org/*"
      ],
      "js": [
        "shared.js",
        "cache-manager.js",
        "rate-limiter.js",
        "batch-executor.js",
        "tasks.js",
        "games.js",
        "ui.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "memory.page.js"
      ],
      "matches": [
        "*://remanga.org/*",
        "*://*.remanga.org/*"
      ]
    }
  ]
}
